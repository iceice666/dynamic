---
import { env } from 'cloudflare:workers';
import AdminLayout from '$/layouts/AdminLayout.astro';
import { getOwnerSession } from '$/utils/adminAuth';
import { listDrafts } from '$/utils/drafts';
import { formatDate } from '$/utils';

const session = await getOwnerSession(Astro);
if (!session) {
  return Astro.redirect('/api/auth/github/login/');
}

const drafts = await listDrafts(env.DRAFTS);
---

<AdminLayout title="Admin — Drafts">
  <main class="mx-auto max-w-2xl px-4 py-10">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-semibold">Drafts</h1>
      <div class="flex items-center gap-3 text-sm">
        <span class="text-muted">Signed in as {session.login}</span>
        <form method="POST" action="/api/auth/logout/">
          <button
            type="submit"
            class="link-accent cursor-pointer border-0 bg-transparent p-0 text-sm"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>

    <form method="POST" action="/api/admin/drafts/" class="mb-6">
      <button
        type="submit"
        class="border-border hover:bg-muted/50 rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
      >
        + New Draft
      </button>
    </form>

    {drafts.length === 0 && <p class="text-muted text-sm">No drafts yet.</p>}

    <ul class="divide-border divide-y">
      {
        drafts.map((draft) => (
          <li class="py-3">
            <a href={`/admin/edit/${draft.id}/`} class="link-accent font-medium">
              {draft.title || 'Untitled'}
            </a>
            <p class="text-muted text-xs">Updated {formatDate(new Date(draft.updatedAt))}</p>
          </li>
        ))
      }
    </ul>
  </main>
</AdminLayout>
