---
import BottomNavList from './BottomNavList';

interface Props {
  currentPath: string;
  toc?: { depth: number; slug: string; text: string }[];
}

const { currentPath, toc } = Astro.props;
---

<nav class="bottom-nav" aria-label="Mobile navigation">
  <BottomNavList client:load transition:persist currentPath={currentPath} toc={toc} />
</nav>

<style>
  .bottom-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .bottom-nav {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      /* Extend below the bar for the iOS home indicator area */
      height: calc(56px + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--color-background);
      border-top: 1px solid var(--color-border);
      z-index: 10;
    }
  }
</style>
