---
import { t, getLocaleLink } from '$/i18n';
import { formatDate, formatRelativeDate } from '$/utils';
import ArticleViewCount from '$/components/widgets/ArticleViewCount';
import { author } from '#/dynamic.config';

interface Props {
  publishedAt: Date;
  tags: string[];
  slug: string;
}

const { publishedAt, tags, slug } = Astro.props;
const { locale } = Astro.locals;
const postPath = `/posts/${slug}/`;
---

<article class="card relative">
  <a href={postPath} class="absolute inset-0 rounded-[inherit]" aria-label={t(locale, 'post_label')}
  ></a>

  <div class="flex items-center gap-3">
    <img
      src={author.avatar}
      alt=""
      width="40"
      height="40"
      loading="lazy"
      class="border-border h-10 w-10 shrink-0 rounded-full border"
    />
    <div class="flex min-w-0 flex-col">
      <span class="text-foreground truncate text-sm leading-tight font-semibold">{author.name}</span
      >
      <time
        class="text-muted text-xs"
        datetime={publishedAt.toISOString()}
        title={formatDate(publishedAt)}
      >
        {formatRelativeDate(publishedAt, t(locale, 'date_format'))}
      </time>
    </div>
    <div class="flex-1"></div>
    <span class="label-uppercase">{t(locale, 'post_label')}</span>
  </div>

  <div class="prose prose-sm text-foreground max-w-none">
    <slot />
  </div>

  <div class="relative z-10 flex flex-wrap items-center gap-2">
    <div class="flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <a href={`${getLocaleLink('/search', locale)}?q=%23${tag}`} class="tag-link">
            #{tag}
          </a>
        ))
      }
    </div>
    <ArticleViewCount client:idle path={postPath} />
  </div>
</article>
